MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gems_db
PORT=3000
SESSION_SECRET=replace_with_a_long_random_string
NODE_ENV=development

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Email notifications (status changes, opportunity events, deadline reminders)
# Master switch: when false, notifications are still saved to the feed but no email is sent.
EMAIL_NOTIFICATIONS_ENABLED=false
# Gmail SMTP (use a Google App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=GEMS <your-address@gmail.com>
# Links inside emails point here
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Manila

# Deadline reminder background job (independent of the immediate event emails above)
ENABLE_DEADLINE_REMINDER_JOB=false
DEADLINE_REMINDER_CRON=0 8 * * *
RUN_DEADLINE_REMINDERS_ON_START=false
DEADLINE_REMINDER_EMAIL_MAX_ATTEMPTS=3