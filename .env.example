# Runtime database-name safeguards:
#   NODE_ENV=development -> database ending in _dev, _development, or _demo
#   NODE_ENV=test        -> database ending in _test
#   NODE_ENV=production  -> database ending in _prod or _production
# Keep real credentials in an ignored .env file or deployment secret manager.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gems_development
PORT=3000
SESSION_SECRET=replace_with_a_long_random_string
NODE_ENV=development

# Destructive development/demo seeding requires both this explicit opt-in and a
# database name ending in _dev, _development, _test, or _demo.
ALLOW_DATABASE_SEED=false

# Daily in-app deadline reminders (8:00 AM Asia/Manila by default)
ENABLE_DEADLINE_REMINDER_JOB=false
DEADLINE_REMINDER_CRON=0 8 * * *
APP_TIMEZONE=Asia/Manila
RUN_DEADLINE_REMINDERS_ON_START=false

# Optional Gmail SMTP delivery for new deadline reminders. Use a dedicated Gmail
# account and an app password; never commit these values in a real .env file.
EMAIL_NOTIFICATIONS_ENABLED=false
DEADLINE_REMINDER_EMAIL_MAX_ATTEMPTS=3
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
