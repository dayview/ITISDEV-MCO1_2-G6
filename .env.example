MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gems_db
PORT=3000
SESSION_SECRET=replace_with_a_long_random_string
NODE_ENV=development

# Daily in-app deadline reminders (8:00 AM Asia/Manila by default)
ENABLE_DEADLINE_REMINDER_JOB=true
DEADLINE_REMINDER_CRON=0 8 * * *
APP_TIMEZONE=Asia/Manila
RUN_DEADLINE_REMINDERS_ON_START=false

# Optional Gmail SMTP delivery for new deadline reminders. Use a dedicated Gmail
# account and an app password; never commit these values in a real .env file.
EMAIL_NOTIFICATIONS_ENABLED=false
DEADLINE_REMINDER_EMAIL_MAX_ATTEMPTS=3
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# SMTP_HOST/PORT/SECURE/USER/PASS above are shared between deadline reminder emails and
# 2FA one-time codes. SMTP_FROM below is the sender used for 2FA codes specifically;
# EMAIL_FROM above is used for deadline reminders.
SMTP_FROM="GEMS OVPERI <no-reply@example.com>"

# Secret used to HMAC-hash 2FA one-time codes before they're stored - codes are never
# persisted in plaintext.
OTP_SECRET=replace_with_a_long_random_string
